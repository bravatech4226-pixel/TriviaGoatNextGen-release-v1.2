rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

    /**
     * Returns true when the request has a Firebase Auth identity.
     */
    function signedIn() {
      return request.auth != null;
    }

    /**
     * Returns true when the request auth UID matches the supplied UID.
     */
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * Hard-coded owner fallback for emergency/admin access.
     */
    function isOwnerAdmin() {
      return signedIn()
        && request.auth.uid == "kqp5LxM5DvSDL3BUEpHmFeoNgw03";
    }

    /**
     * Returns the admin role document path for the active user.
     */
    function adminRoleDocPath() {
      return /databases/$(database)/documents/admin/roles/roles/$(request.auth.uid);
    }

    /**
     * Returns true when the active user has an admin role document.
     */
    function hasAdminRoleDoc() {
      return signedIn() && exists(adminRoleDocPath());
    }

    /**
     * Returns the active user's admin role document.
     */
    function adminRoleDoc() {
      return get(adminRoleDocPath());
    }

    /**
     * Returns true when the active user can manage web/admin surfaces.
     */
    function isWebAdmin() {
      return isOwnerAdmin() || (
        hasAdminRoleDoc()
        && (
          adminRoleDoc().data.isSuperAdmin == true
          || adminRoleDoc().data.canManageWeb == true
          || adminRoleDoc().data.canManageGlobalBattle == true
          || adminRoleDoc().data.canManageBlog == true
          || adminRoleDoc().data.canManageStats == true
          || adminRoleDoc().data.canManageUsers == true
        )
      );
    }

    /**
     * Returns true when the active user can manage blog content.
     */
    function isBlogAdmin() {
      return isOwnerAdmin() || (
        hasAdminRoleDoc()
        && (
          adminRoleDoc().data.isSuperAdmin == true
          || adminRoleDoc().data.canManageBlog == true
        )
      );
    }

    /**
     * Returns true when the active user can manage public stats.
     */
    function isStatsAdmin() {
      return isOwnerAdmin() || (
        hasAdminRoleDoc()
        && (
          adminRoleDoc().data.isSuperAdmin == true
          || adminRoleDoc().data.canManageStats == true
        )
      );
    }

    /**
     * Allows approved comments, admins, or the comment author to read.
     */
    function canReadComment() {
      return resource.data.status == "approved"
        || isWebAdmin()
        || (
          signedIn()
          && resource.data.authorUID is string
          && resource.data.authorUID == request.auth.uid
        );
    }
    /**
    * Returns true when the active user is the organizer of the current event doc.
    */
    function isEventOrganizer() {
    return signedIn()
    && resource.data.organizerUID is string
    && resource.data.organizerUID == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() || resource.data.isPublic == true;
      allow create: if isSelf(uid) || isWebAdmin();
      allow update: if isSelf(uid) || isWebAdmin();
      allow delete: if false;
    }

    match /usernames/{usernameKey} {
      allow read: if signedIn();
      allow write, delete: if false;
    }

    match /leaderboard/{docId} {
      allow read: if true;
      allow write, delete: if false;

      match /{sub=**} {
        allow read: if true;
        allow write, delete: if false;
      }
    }

    match /leaderboards/{docId} {
      allow read: if true;
      allow write, delete: if false;

      match /{sub=**} {
        allow read: if true;
        allow write, delete: if false;
      }
    }

    match /admin/config/config/{docId} {
      allow read: if signedIn();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /adminConfig/{docId} {
      allow read: if signedIn();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /platformConfig/{docId} {
      allow read: if isWebAdmin();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /admin/roles/roles/{uid} {
      allow read: if isWebAdmin();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /public/config/config/{docId} {
      allow read: if true;
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /featureFlags/{docId} {
      allow read: if signedIn();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if resource.data.status == "approved"
        || isWebAdmin()
        || (signedIn() && resource.data.authorUID == request.auth.uid);

      allow create: if isWebAdmin() || (
        signedIn()
        && request.resource.data.status == "pending"
        && request.resource.data.authorUID == request.auth.uid
      );

      allow update: if isWebAdmin();
      allow delete: if false;

      match /likes/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if canReadComment();

        allow create: if signedIn()
          && request.resource.data.postID == postId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.isAI == false
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt != null
          && (
            !("authorUID" in request.resource.data)
            || request.resource.data.authorUID == request.auth.uid
          )
          && (
            !("parentCommentID" in request.resource.data)
            || request.resource.data.parentCommentID is string
          );

        allow update: if isWebAdmin();

        allow delete: if isWebAdmin()
          || (
            signedIn()
            && resource.data.authorUID is string
            && resource.data.authorUID == request.auth.uid
          );
      }
    }

    match /{path=**}/comments/{commentId} {
      allow read: if canReadComment();
      allow update: if isWebAdmin();
    }

    match /postSubmissions/{submissionId} {
      allow read: if isWebAdmin()
        || (
          signedIn()
          && resource.data.authorUID == request.auth.uid
        );
      allow create: if signedIn();
      allow update: if isWebAdmin();
      allow delete: if false;
    }

    match /moderationQueue/{queueId} {
      allow read: if isWebAdmin();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /events/{eventId} {
  allow read: if true;

  allow create: if isWebAdmin()
    || (
      signedIn()
      && request.resource.data.organizerUID == request.auth.uid
      && request.resource.data.submittedByUID == request.auth.uid
      && request.resource.data.approvalStatus == "draft"
      && request.resource.data.status == "draft"
      && request.resource.data.published == false
    );

  allow update: if (
    isWebAdmin()
    || (
      isEventOrganizer()
      && request.resource.data.organizerUID == resource.data.organizerUID
      && request.resource.data.attendeeCount == resource.data.attendeeCount
      && request.resource.data.waitlistCount == resource.data.waitlistCount
      && request.resource.data.approvalStatus in ["draft", "submitted", "rejected"]
    )
  );

  allow delete: if false;

  match /accessLeads/{leadId} {
    allow read: if isWebAdmin();
    allow create: if true;
    allow update: if isWebAdmin();
    allow delete: if false;
  }

  match /accessRequests/{uid} {
    allow read: if isWebAdmin() || isSelf(uid);
    allow create: if signedIn() && isSelf(uid);
    allow update: if isWebAdmin();
    allow delete: if false;
  }

  match /invites/{uid} {
    allow read: if isWebAdmin() || isSelf(uid);
    allow create, update: if isWebAdmin();
    allow delete: if false;
  }

  match /waitlist/{uid} {
    allow read: if isWebAdmin() || isSelf(uid);
    allow create: if signedIn() && isSelf(uid);
    allow update: if isWebAdmin();
    allow delete: if false;
  }

    /**
   * Event RSVP records.
   * Clients may create or refresh only their own attendee record.
   * Event counters remain server-authoritative via Cloud Functions.
   */
  match /attendees/{uid} {
    allow read: if true;
    allow create, update: if signedIn() && isSelf(uid);
    allow delete: if signedIn() && isSelf(uid);
  }

  /**
   * Event RSVP records.
   * Clients may read only their own RSVP record for UI hydration.
   * RSVP writes are server-authoritative via Cloud Functions.
   */
  match /rsvps/{uid} {
    allow read: if isWebAdmin() || isSelf(uid);
    allow create, update, delete: if false;
  }
}

    match /{path=**}/accessLeads/{leadId} {
      allow read: if isWebAdmin();
      allow update: if isWebAdmin();
    }

    match /{path=**}/accessRequests/{uid} {
      allow read: if isWebAdmin() || isSelf(uid);
      allow update: if isWebAdmin();
    }

    match /{path=**}/invites/{uid} {
      allow read: if isWebAdmin() || isSelf(uid);
      allow update: if isWebAdmin();
    }

    match /{path=**}/waitlist/{uid} {
      allow read: if isWebAdmin() || isSelf(uid);
      allow update: if isWebAdmin();
    }

    match /sponsors/{sponsorId} {
      allow read: if isWebAdmin();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if isWebAdmin();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /placements/{placementId} {
      allow read: if isWebAdmin();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /stats/{statId} {
      allow read: if true;
      allow create, update: if isWebAdmin() || isStatsAdmin();
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isWebAdmin();
      allow create: if isWebAdmin();
      allow update, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isWebAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /dailyQuestionPacks/{docId} {
      allow read: if signedIn();
      allow write, delete: if false;

      match /{sub=**} {
        allow read: if signedIn();
        allow write, delete: if false;
      }
    }

    match /dailyMissionPacks/{docId} {
      allow read: if signedIn();
      allow write, delete: if false;

      match /{sub=**} {
        allow read: if signedIn();
        allow write, delete: if false;
      }
    }

    match /telemetry/events/events/{eventId} {
      allow create: if signedIn();
      allow read: if isWebAdmin();
      allow update, delete: if false;
    }

    match /telemetry/dailyMission/payloads/{payloadId} {
      allow create: if signedIn();
      allow read: if isWebAdmin();
      allow update, delete: if false;
    }

    match /globalBattles/{lobbyId} {
      allow read, create, update: if signedIn();
      allow delete: if false;

      match /participants/{participantId} {
        allow read, create, update: if signedIn();
        allow delete: if false;
      }

      match /usedQuestionKeys/{keyId} {
        allow read, create, update: if signedIn();
        allow delete: if false;
      }

      match /runtime/{docId} {
        allow read, create, update: if signedIn();
        allow delete: if false;
      }

      match /rounds/{roundId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if false;

        match /answers/{answerId} {
          allow read, create, update: if signedIn();
          allow delete: if false;
        }
      }
    }

    match /website/{docId} {
      allow read: if true;
      allow write, delete: if false;

      match /publicConfig/{configId} {
        allow read: if true;
        allow create, update: if isWebAdmin();
        allow delete: if false;
      }

      match /publicConfig/monetization/publicConfig/{placementId} {
        allow read: if true;
        allow create, update: if isWebAdmin();
        allow delete: if false;
      }

      match /blog/posts/posts/{postId} {
        allow read: if isBlogAdmin() || resource.data.isPublished == true;
        allow create, update: if isBlogAdmin();
        allow delete: if isBlogAdmin();
      }

      match /publicStats/publicStats/publicStats/{statId} {
        allow read: if isStatsAdmin() || resource.data.isVisible == true;
        allow create, update: if isStatsAdmin();
        allow delete: if isStatsAdmin();
      }

      match /leaderboard/snapshots/snapshots/{entryId} {
        allow read: if true;
        allow create, update: if isStatsAdmin();
        allow delete: if isStatsAdmin();
      }
    }

    match /trialRedemptions/{redemptionId} {
      allow read: if isWebAdmin();
      allow create, update: if isWebAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

